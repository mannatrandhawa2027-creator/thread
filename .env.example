# Thread configuration - copy to .env and fill in ONE provider key.
# With no key set, Thread falls back to a free keyless text-only endpoint
# (patterns are generated from your written choices; photos are NOT analyzed).

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to disable the keyless fallback and show setup instructions instead:
# REQUIRE_API_KEY=1

# PORT=3000
